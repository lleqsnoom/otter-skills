{
  "name": "@lleqsnoom/otter-pm",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A local project board over one or more repositories' .x-skills trees: what is in progress, what is waiting, and what is done.",
  "bin": {
    "otter-pm": "./scripts/serve.mjs",
    "otter-pm-mcp": "./scripts/mcp.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src/",
    "scripts/",
    "public/",
    "astro.config.mjs",
    "tsconfig.json",
    "otter-pm.config.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "install": "node scripts/install.mjs",
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/seed-demo.mjs",
    "build": "astro build",
    "start": "node scripts/serve.mjs --no-build",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/solid-js": "^7.0.2",
    "@huggingface/transformers": "^4.3.0",
    "@kobalte/core": "^0.13.14",
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "clsx": "^2.1.1",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "shiki": "^4.4.3",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lleqsnoom/otter-pm.git"
  },
  "homepage": "https://github.com/lleqsnoom/otter-pm#readme",
  "bugs": {
    "url": "https://github.com/lleqsnoom/otter-pm/issues"
  }
}
