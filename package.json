{
  "name": "@lleqsnoom/otter-pm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A suite of o-* skills and an MCP server over .x-skills project trees.",
  "bin": {
    "otter-pm-mcp": "./scripts/mcp.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src/",
    "scripts/",
    "otter-pm.config.json",
    "README.md"
  ],
  "scripts": {
    "test": "npm run validate:skills && node --test --test-concurrency=1 test/*.test.cjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "install": "node scripts/install.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lleqsnoom/otter-pm.git"
  },
  "homepage": "https://github.com/lleqsnoom/otter-pm#readme",
  "bugs": {
    "url": "https://github.com/lleqsnoom/otter-pm/issues"
  }
}
